[sub_resource type="GDScript" id="GDScript_dmp64"]
script/source = "extends StaticBody3D

func _ready():
	var thickness = 0.1  # Grosor delgado
	var height = 1.5     # Altura adecuada
	var color = Color(1, 0, 0, 0.7)  # Rojo semitransparente
	
	# Barrera izquierda (diagonal)
	create_barrier_between_points(
		Vector3(-0.893, -3.833, -104.97),
		Vector3(-0.982, -3.833, -91.675),
		height,
		thickness,
		color
	)
	
	# Barrera derecha (vertical)
	create_barrier_between_points(
		Vector3(-3.414, -3.717, -105.002),
		Vector3(-3.414, -3.717, -91.623),
		height,
		thickness,
		color
	)
	
	# Segunda barrera izquierda
	create_barrier_between_points(
		Vector3(0.3, -3.853, -90.273),
		Vector3(8.582, -3.853, -90.273),
		height,
		thickness,
		color
	)
	
	# Segunda barrera derecha
	create_barrier_between_points(
		Vector3(0.3, -3.853, -87.691),
		Vector3(8.505, -3.988, -87.691),
		height,
		thickness,
		color
	)
	
	# Ejemplo de barrera curva
	create_curve_barrier(
		Vector3(0, -3.8, -50),  # Centro de la curva
		10.0,                   # Radio
		-90.0,                  # Ángulo inicial (grados)
		180.0,                  # Ángulo de arco (grados)
		height,
		thickness,
		color
	)

# Función corregida para barreras rectas
func create_barrier_between_points(start: Vector3, end: Vector3, height: float, thickness: float, color: Color):
	# Calcular dirección y longitud
	var direction = (end - start).normalized()
	var length = start.distance_to(end)
	
	# Calcular centro
	var center = (start + end) / 2
	center.y = min(start.y, end.y) + height / 2
	
	# Crear material
	var material = StandardMaterial3D.new()
	material.albedo_color = color
	material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA_SCISSOR
	
	# Crear colisión
	var collision_shape = CollisionShape3D.new()
	var box_shape = BoxShape3D.new()
	box_shape.size = Vector3(thickness, height, length)
	collision_shape.shape = box_shape
	add_child(collision_shape)
	
	# Crear malla visible
	var mesh_instance = MeshInstance3D.new()
	var box_mesh = BoxMesh.new()
	box_mesh.size = Vector3(thickness, height, length)
	box_mesh.material = material
	mesh_instance.mesh = box_mesh
	add_child(mesh_instance)
	
	# Posicionar
	collision_shape.global_position = center
	mesh_instance.global_position = center
	
	# CORRECCIÓN PARA BARRERAS DIAGONALES
	# Calcular el ángulo correcto de rotación
	var horizontal_direction = Vector2(direction.x, direction.z).normalized()
	var angle = atan2(horizontal_direction.x, horizontal_direction.y)
	
	# Aplicar rotación
	collision_shape.rotation.y = angle
	mesh_instance.rotation.y = angle

# Función para barreras curvas (sin cambios)
func create_curve_barrier(center: Vector3, radius: float, start_angle_deg: float, arc_angle_deg: float, height: float, thickness: float, color: Color):
	# Convertir ángulos a radianes
	var start_angle = deg_to_rad(start_angle_deg)
	var arc_angle = deg_to_rad(arc_angle_deg)
	
	# Determinar número de segmentos
	var segment_count = max(8, int(abs(arc_angle_deg) / 10))
	var angle_step = arc_angle / segment_count
	
	# Crear material para todos los segmentos
	var material = StandardMaterial3D.new()
	material.albedo_color = color
	material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA_SCISSOR
	
	for i in range(segment_count):
		# Calcular ángulos para este segmento
		var angle1 = start_angle + i * angle_step
		var angle2 = angle1 + angle_step
		
		# Calcular puntos en la curva
		var point1 = Vector3(
			center.x + radius * cos(angle1),
			center.y,
			center.z + radius * sin(angle1)
		)
		
		var point2 = Vector3(
			center.x + radius * cos(angle2),
			center.y,
			center.z + radius * sin(angle2)
		)
		
		# Calcular dirección tangente (perpendicular al radio)
		var tangent_angle = angle1 + angle_step/2
		var tangent = Vector3(
			-sin(tangent_angle), 
			0, 
			cos(tangent_angle)
		).normalized()
		
		# Calcular punto medio para posicionamiento
		var segment_center = Vector3(
			center.x + radius * cos(tangent_angle),
			center.y,
			center.z + radius * sin(tangent_angle)
		)
		segment_center.y = min(point1.y, point2.y) + height / 2
		
		# Calcular longitud del segmento
		var segment_length = point1.distance_to(point2)
		
		# Crear colisión
		var collision_shape = CollisionShape3D.new()
		var box_shape = BoxShape3D.new()
		box_shape.size = Vector3(thickness, height, segment_length)
		collision_shape.shape = box_shape
		add_child(collision_shape)
		collision_shape.global_position = segment_center
		
		# Crear malla visible
		var mesh_instance = MeshInstance3D.new()
		var box_mesh = BoxMesh.new()
		box_mesh.size = Vector3(thickness, height, segment_length)
		box_mesh.material = material
		mesh_instance.mesh = box_mesh
		add_child(mesh_instance)
		mesh_instance.global_position = segment_center
		
		# Orientar según la tangente de la curva
		var horizontal_tangent = Vector2(tangent.x, tangent.z).normalized()
		var angle = atan2(horizontal_tangent.x, horizontal_tangent.y)
		collision_shape.rotation.y = angle
		mesh_instance.rotation.y = angle
"

